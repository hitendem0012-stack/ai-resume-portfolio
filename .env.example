# Optional frontend mode switch.
# Leave blank for the provider-not-configured state.
# Set to "demo" to enable the clearly labelled local template-script adapter.
VITE_AI_MODE=

# SECURITY: never put a secret in a variable beginning with VITE_. Vite exposes
# VITE_ variables to the browser bundle. Real provider keys must live on a backend.
# AVATAR_PROVIDER_API_KEY=
